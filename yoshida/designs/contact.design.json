{
  "format": 1,
  "name": "Contact",
  "canvas": { "width": 270, "height": 64, "background": "#0A1424" },
  "fonts": {
    "mono": "assets/fonts/JetBrainsMono-Regular.ttf",
    "bold": "assets/fonts/JetBrainsMono-Bold.ttf",
    "head": "assets/fonts/ChakraPetch-Bold.ttf"
  },
  "consts": {
    "c_bg": "#0A1424",
    "c_panel": "#0F1D33",
    "c_line": "#24456E",
    "c_hair": "#8CCBF5",
    "c_ice": "#C9EBFF",
    "c_eye": "#2E9BE0",
    "c_trim": "#D9E04A",
    "c_muted": "#7E9CC0"
  },
  "params": {
    "label": { "type": "text", "default": "discord" },
    "value": { "type": "text", "default": "name" },
    "icon": { "type": "text", "default": "discord" }
  },
  "layers": [
    {
      "id": "box",
      "type": "rect",
      "box": { "x": 0, "y": 0, "w": 270, "h": 64 },
      "fill": "c_panel"
    },
    {
      "id": "edge",
      "type": "rect",
      "box": { "x": 0, "y": 0, "w": 4, "h": 64 },
      "fill": "c_eye"
    },
    {
      "id": "ico",
      "type": "image",
      "src": "assets/icons/{icon}.svg",
      "optional": true,
      "fit": "contain",
      "box": { "x": 16, "y": 19, "w": 28, "h": 28 }
    },
    {
      "id": "env_box",
      "type": "rect",
      "visible": "icon == 'mail'",
      "box": { "x": 16, "y": 22, "w": 28, "h": 20 },
      "fill": "#00000000",
      "stroke": { "color": "c_hair", "width": 2 }
    },
    {
      "id": "env_flap",
      "type": "polygon",
      "visible": "icon == 'mail'",
      "closed": false,
      "points": [[16, 22], [30, 34], [44, 22]],
      "stroke": { "color": "c_hair", "width": 2 }
    },
    {
      "id": "label",
      "type": "text",
      "font": "bold",
      "text": "{upper(label)}",
      "at": { "x": 62, "y": 12 },
      "size": 10,
      "color": "c_muted"
    },
    {
      "id": "value",
      "type": "text",
      "font": "head",
      "text": "{value}",
      "at": { "x": 62, "y": 28 },
      "size": 19,
      "color": "c_ice",
      "max_width": 176
    },
    {
      "id": "arrow",
      "type": "polygon",
      "shape": { "type": "arrow", "inner": 0.35 },
      "box": { "x": 238, "y": 22, "w": 20, "h": 20 },
      "fill": "c_trim",
      "rotate": -45
    }
  ]
}
