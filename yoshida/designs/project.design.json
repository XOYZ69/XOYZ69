				[230, 32],
				[227, 14],
				[210, 32]
			],
			"fill": "c_pink",
			"opacity": 0.85
		},
		{
			"id": "tag",
			"type": "text",
			"font": "mono",
			"text": "[{pad_start(fmt(render.index + 1, 0), 2, '0')}] {upper(kind)}",
			"at": { "x": 32, "y": 52 },
			"size": 12,
			"color": "c_hair"
		},
		{
			"id": "ver_box",
			"type": "rect",
			"box": {
				"x": "232 - @ver.bounds.w - 10",
				"y": 46,
				"w": "@ver.bounds.w + 20",
				"h": 24
			},
			"fill": "#00000000",
			"stroke": { "color": "c_trim", "width": 1.5 }
		},
		{
			"id": "ver",
			"type": "text",
			"font": "bold",
			"text": "{version}",
			"at": { "x": 232, "y": 51 },
			"size": 13,
			"color": "c_trim",
			"anchor": "top-right"
		},
		{
			"id": "name",
			"type": "text",
			"font": "bold",
			"text": "{name}",
			"at": { "x": 30, "y": 98 },
			"size": 26,
			"color": "c_ice",
			"max_width": 212
		},
		{
			"id": "blurb",
			"type": "text",
			"font": "mono",
			"text": "{blurb}",
			"at": { "x": 32, "y": "@name.bounds.bottom + 14" },
			"size": 12,
			"color": "c_hair",
			"wrap": 208,
			"line_spacing": 5,
			"max_lines": 4
		},
		{
			"id": "quip",
			"type": "text",
			"font": "mono",
			"text": "// {quip}",
			"at": { "x": 32, "y": "@blurb.bounds.bottom + 12" },
			"size": 11,
			"color": "c_muted",
			"max_width": 208
		},
		{
			"id": "foot_rule",
			"type": "rect",
			"box": { "x": 30, "y": 284, "w": 212, "h": 1 },
			"fill": "c_line"
		},
		{
			"id": "lang_dot",
			"type": "rect",
			"box": { "x": 32, "y": 301, "w": 9, "h": 9 },
			"fill": "lang_color"
		},
		{
			"id": "lang",
			"type": "text",
			"font": "mono",
			"text": "{lang}",
			"at": { "x": 48, "y": 298 },
			"size": 13,
			"color": "c_ice"
		},
		{
			"id": "paw_s",
			"type": "group",
			"translate": { "x": "@lang.bounds.right + 10", "y": 299 },
			"rotate": 0,
			"opacity": 1,
			"layers": [
				{
					"id": "paw_s_pad",
