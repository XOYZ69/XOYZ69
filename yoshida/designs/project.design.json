{
	"format": 1,
	"name": "Project card",
	"canvas": { "width": 272, "height": 344, "background": "00000000" },
	"fonts": {
		"mono": "assets/fonts/JetBrainsMono-Regular.ttf",
		"bold": "assets/fonts/JetBrainsMono-Bold.ttf"
	},
	"consts": {
		"c_bg": "#0A1424",
		"c_panel": "#0F1D33",
		"c_line": "#24456E",
		"c_hair": "#8CCBF5",
		"c_ice": "#C9EBFF",
		"c_eye": "#2E9BE0",
		"c_green": "#6D9382",
		"c_trim": "#D9E04A",
		"c_pink": "#F7D7C9",
		"c_muted": "#7E9CC0"
	},
	"params": {
		"name": { "type": "text", "default": "Project" },
		"kind": { "type": "text", "default": "OSS" },
		"blurb": { "type": "text", "default": "What it does." },
		"quip": { "type": "text", "default": "" },
		"lang": { "type": "text", "default": "Rust" },
		"lang_color": { "type": "color", "default": "#DEA584" },
		"version": { "type": "text", "default": "v0.1.0" },
		"stage": { "type": "text", "default": "stable" }
	},
	"layers": [
		{
			"id": "frame",
