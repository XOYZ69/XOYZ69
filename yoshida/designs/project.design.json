{
  "format": 1,
  "name": "Project card",
  "canvas": { "width": 272, "height": 344, "background": "#00000000" },
  "fonts": {
    "mono": "assets/fonts/JetBrainsMono-Regular.ttf",
    "bold": "assets/fonts/JetBrainsMono-Bold.ttf",
    "head": "assets/fonts/ChakraPetch-Bold.ttf"
  },
  "consts": {
    "c_bg": "#0A1424",
    "c_panel": "match(mode, 'dark', #0F1D33B8, #DDE8F58C)",
    "c_line": "match(mode, 'dark', #24456E, #9DB6D6)",
    "c_hair": "match(mode, 'dark', #8CCBF5, #0B5CAD)",
    "c_ice": "match(mode, 'dark', #C9EBFF, #0B1B33)",
    "c_eye": "match(mode, 'dark', #2E9BE0, #0969DA)",
    "c_trim": "match(mode, 'dark', #D9E04A, #B8A800)",
    "c_muted": "match(mode, 'dark', #7E9CC0, #57606A)",
    "c_pink": "#F7D7C9"
  },
  "params": {
    "mode": { "type": "text", "default": "dark" },
    "name": { "type": "text", "default": "Project" },
    "kind": { "type": "text", "default": "OSS" },
    "blurb": { "type": "text", "default": "What it does." },
    "quip": { "type": "text", "default": "" },
    "lang": { "type": "text", "default": "Rust" },
    "lang_color": { "type": "color", "default": "#DEA584" },
    "version": { "type": "text", "default": "v0.1.0" },
    "stage": { "type": "text", "default": "stable" },
    "featured": { "type": "bool", "default": false }
  },
  "layers": [
    {
      "id": "frame",
      "type": "rect",
      "box": { "x": 1, "y": 32, "w": 270, "h": 302 },
      "fill": "c_panel",
      "stroke": { "color": "c_line", "width": 1.5 }
    },
    {
      "id": "ear_l_fill",
      "type": "polygon",
      "points": [[30, 36], [38, 2], [76, 36]],
      "fill": "c_panel",
      "visible": "featured"
    },
    {
      "id": "ear_l_line",
      "type": "polygon",
      "closed": false,
      "points": [[30, 31], [38, 2], [76, 31]],
      "stroke": { "color": "c_hair", "width": 2 },
      "visible": "featured"
    },
    {
      "id": "ear_l_in",
      "type": "polygon",
      "points": [[42, 32], [45, 14], [62, 32]],
      "fill": "c_pink",
      "opacity": 0.85,
      "visible": "featured"
    },
    {
      "id": "ear_r_fill",
      "type": "polygon",
      "points": [[242, 36], [234, 2], [196, 36]],
      "fill": "c_panel",
      "visible": "featured"
    },
    {
      "id": "ear_r_line",
      "type": "polygon",
      "closed": false,
      "points": [[242, 31], [234, 2], [196, 31]],
      "stroke": { "color": "c_hair", "width": 2 },
      "visible": "featured"
    },
    {
      "id": "ear_r_in",
      "type": "polygon",
      "points": [[230, 32], [227, 14], [210, 32]],
      "fill": "c_pink",
      "opacity": 0.85,
      "visible": "featured"
    },
    {
      "id": "tag",
      "type": "text",
      "font": "mono",
      "text": "[{pad_start(fmt(floor(render.index / 2) + 1, 0), 2, '0')}] {upper(kind)}",
      "at": { "x": 32, "y": 52 },
      "size": 12,
      "color": "c_hair"
    },
    {
      "id": "ver_box",
      "type": "rect",
      "box": { "x": "232 - @ver.bounds.w - 10", "y": 46, "w": "@ver.bounds.w + 20", "h": 24 },
      "fill": "#00000000",
      "stroke": { "color": "c_trim", "width": 1.5 },
      "visible": "version != 'no release'"
    },
    {
      "id": "ver",
      "type": "text",
      "font": "bold",
      "text": "{version}",
      "at": { "x": 232, "y": 51 },
      "size": 13,
      "color": "c_trim",
      "anchor": "top-right",
      "visible": "version != 'no release'"
    },
    {
      "id": "name",
      "type": "text",
      "font": "head",
      "text": "{name}",
      "at": { "x": 30, "y": 98 },
      "size": 30,
      "color": "c_ice",
      "max_width": 212
    },
    {
      "id": "blurb",
      "type": "text",
      "font": "mono",
      "text": "{blurb}",
      "at": { "x": 32, "y": "@name.bounds.bottom + 14" },
      "size": 13,
      "color": "c_ice",
      "wrap": 208,
      "line_spacing": 5,
      "max_lines": 4
    },
    {
      "id": "quip",
      "type": "text",
      "font": "mono",
      "text": "// {quip}",
      "at": { "x": 32, "y": "@blurb.bounds.bottom + 12" },
      "size": 11,
      "color": "c_muted",
      "max_width": 208
    },
    {
      "id": "foot_rule",
      "type": "rect",
      "box": { "x": 30, "y": 284, "w": 212, "h": 1 },
      "fill": "c_line"
    },
    {
      "id": "lang_dot",
      "type": "rect",
      "box": { "x": 32, "y": 301, "w": 9, "h": 9 },
      "fill": "lang_color"
    },
    {
      "id": "lang",
      "type": "text",
      "font": "mono",
      "text": "{lang}",
      "at": { "x": 48, "y": 299 },
      "size": 12,
      "color": "c_ice"
    },
    {
      "id": "stage",
      "type": "text",
      "font": "mono",
      "text": "{stage}",
      "at": { "x": 236, "y": 299 },
      "size": 12,
      "color": "c_muted",
      "anchor": "top-right"
    },
    {
      "id": "ver_none",
      "type": "text",
      "font": "mono",
      "text": "no release yet",
      "at": { "x": 242, "y": 51 },
      "size": 11,
      "color": "c_muted",
      "anchor": "top-right",
      "visible": "version == 'no release'"
    }
  ]
}
