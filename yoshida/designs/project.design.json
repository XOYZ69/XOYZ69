					"fill": "c_pink"
				},
				{
					"id": "paw_s_toe1",
					"type": "ellipse",
					"box": { "x": 4.2, "y": 0, "w": 3.78, "h": 4.62 },
					"fill": "c_pink"
				},
				{
					"id": "paw_s_toe2",
					"type": "ellipse",
					"box": { "x": 9.24, "y": 0, "w": 3.78, "h": 4.62 },
					"fill": "c_pink"
				},
				{
					"id": "paw_s_toe3",
					"type": "ellipse",
					"box": { "x": 13.44, "y": 4.2, "w": 3.78, "h": 4.62 },
					"fill": "c_pink"
				}
			]
		},
		{
			"id": "stage",
			"type": "text",
			"font": "mono",
			"text": "{stage}",
			"at": { "x": 236, "y": 301 },
			"size": 11,
			"color": "c_muted",
			"anchor": "top-right"
		}
	]
}
