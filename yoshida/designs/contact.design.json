{
  "format": 1,
  "name": "Contact",
  "canvas": { "width": 270, "height": 52, "background": "#00000000" },
  "fonts": {
    "mono": "assets/fonts/JetBrainsMono-Regular.ttf",
    "bold": "assets/fonts/JetBrainsMono-Bold.ttf",
    "head": "assets/fonts/ChakraPetch-Bold.ttf"
  },
  "consts": {
    "c_bg": "#0A1424",
    "c_panel": "match(mode, 'dark', #0F1D33B8, #DDE8F58C)",
    "c_line": "match(mode, 'dark', #24456E, #9DB6D6)",
    "c_hair": "match(mode, 'dark', #8CCBF5, #0B5CAD)",
    "c_ice": "match(mode, 'dark', #C9EBFF, #0B1B33)",
    "c_eye": "match(mode, 'dark', #2E9BE0, #0969DA)",
    "c_trim": "match(mode, 'dark', #D9E04A, #B8A800)",
    "c_muted": "match(mode, 'dark', #7E9CC0, #57606A)",
    "c_pink": "#F7D7C9"
  },
  "params": {
    "mode": { "type": "text", "default": "dark" },
    "label": { "type": "text", "default": "discord" },
    "value": { "type": "text", "default": "name" },
    "icon": { "type": "text", "default": "discord" }
  },
  "layers": [
    {
      "id": "box",
      "type": "rect",
      "box": { "x": 0, "y": 0, "w": 270, "h": 52 },
      "fill": "c_panel",
      "stroke": { "color": "c_line", "width": 1 }
    },
    {
      "id": "ico",
      "type": "image",
      "src": "assets/icons/{icon}.svg",
      "optional": true,
      "fit": "contain",
      "box": { "x": 14, "y": 13, "w": 26, "h": 26 }
    },
    {
      "id": "env_box",
      "type": "rect",
      "visible": "icon == 'mail'",
      "box": { "x": 14, "y": 16, "w": 26, "h": 20 },
      "fill": "#00000000",
      "stroke": { "color": "c_hair", "width": 2 }
    },
    {
      "id": "env_flap",
      "type": "polygon",
      "visible": "icon == 'mail'",
      "closed": false,
      "points": [[14, 16], [27, 27], [40, 16]],
      "stroke": { "color": "c_hair", "width": 2 }
    },
    {
      "id": "label",
      "type": "text",
      "font": "bold",
      "text": "{upper(label)}",
      "at": { "x": 54, "y": 9 },
      "size": 9,
      "color": "c_muted"
    },
    {
      "id": "value",
      "type": "text",
      "font": "head",
      "text": "{value}",
      "at": { "x": 54, "y": 23 },
      "size": 17,
      "color": "c_ice",
      "max_width": 204
    }
  ]
}
