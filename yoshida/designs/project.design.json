						"w": 48,
						"h": 39.99999999999999
					},
					"fill": "with_alpha(c_eye, 0.10)"
				},
				{
					"id": "paw_big_toe0",
					"type": "ellipse",
					"box": {
						"x": 0,
						"y": 19.999999999999996,
						"w": 18.000000000000004,
						"h": 22
					},
					"fill": "with_alpha(c_eye, 0.10)"
				},
				{
					"id": "paw_big_toe1",
					"type": "ellipse",
					"box": {
						"x": 19.999999999999996,
						"y": 0,
						"w": 18.000000000000004,
						"h": 22
					},
					"fill": "with_alpha(c_eye, 0.10)"
				},
				{
					"id": "paw_big_toe2",
					"type": "ellipse",
					"box": { "x": 44, "y": 0, "w": 18.000000000000004, "h": 22 },
					"fill": "with_alpha(c_eye, 0.10)"
				},
				{
					"id": "paw_big_toe3",
					"type": "ellipse",
					"box": {
						"x": 64,
						"y": 19.999999999999996,
						"w": 18.000000000000004,
						"h": 22
					},
					"fill": "with_alpha(c_eye, 0.10)"
				}
			]
		},
		{
			"id": "strip",
			"type": "rect",
			"box": { "x": 11, "y": 33, "w": 5, "h": 300 },
			"fill": "c_eye"
		},
		{
			"id": "ear_l_fill",
			"type": "polygon",
			"points": [
				[30, 36],
