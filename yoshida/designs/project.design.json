			"fill": "c_panel"
		},
		{
			"id": "ear_l_line",
			"type": "polygon",
			"closed": false,
			"points": [
				[30, 31],
				[38, 2],
				[76, 31]
			],
			"stroke": { "color": "c_hair", "width": 2 }
		},
