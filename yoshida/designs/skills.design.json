{
  "format": 1,
  "name": "Skills",
  "canvas": { "width": 830, "height": 268, "background": "#00000000" },
  "fonts": {
    "mono": "assets/fonts/JetBrainsMono-Regular.ttf",
    "bold": "assets/fonts/JetBrainsMono-Bold.ttf",
    "head": "assets/fonts/ChakraPetch-Bold.ttf"
  },
  "consts": {
    "c_bg": "#0A1424",
    "c_panel": "match(mode, 'dark', #0F1D33B8, #DDE8F58C)",
    "c_line": "match(mode, 'dark', #24456E, #9DB6D6)",
    "c_hair": "match(mode, 'dark', #8CCBF5, #0B5CAD)",
    "c_ice": "match(mode, 'dark', #C9EBFF, #0B1B33)",
    "c_eye": "match(mode, 'dark', #2E9BE0, #0969DA)",
    "c_trim": "match(mode, 'dark', #D9E04A, #B8A800)",
    "c_muted": "match(mode, 'dark', #7E9CC0, #57606A)",
    "c_pink": "#F7D7C9"
  },
  "params": {
    "mode": { "type": "text", "default": "dark" },
    "main": {
      "type": "list",
      "default": [
        { "name": "Python", "icon": "python", "meta": "6 repos · 3d ago", "trend": "rising" },
        { "name": "Zig", "icon": "zig", "meta": "2 repos · 1d ago", "trend": "rising" },
        { "name": "LaTeX", "icon": "latex", "meta": "3 repos · 4 mo ago", "trend": "steady" },
        { "name": "Arduino", "icon": "arduino", "meta": "2 repos · 9 mo ago", "trend": "steady" }
      ],
      "item": { "name": "text", "icon": "text", "meta": "text", "trend": "text" }
    },
    "sub": {
      "type": "list",
      "default": [
        { "name": "Git", "icon": "git", "active": true },
        { "name": "Linux", "icon": "linux", "active": true },
        { "name": "Raspberry Pi", "icon": "raspberrypi", "active": false },
        { "name": "Bash", "icon": "gnubash", "active": true },
        { "name": "C++", "icon": "cplusplus", "active": false },
        { "name": "Rust", "icon": "rust", "active": false }
      ],
      "item": { "name": "text", "icon": "text", "active": "bool" }
    }
  },
  "layers": [
    {
      "id": "main_cell",
      "type": "group",
      "repeat": { "each": "main", "item": "m", "index": "i" },
      "translate": { "x": "i * 211", "y": 18 },
      "layers": [
        {
          "id": "ear_l",
          "type": "polygon",
          "visible": "i == 0",
          "closed": false,
          "points": [[14, 2], [22, -16], [52, 2]],
          "stroke": { "color": "c_hair", "width": 2 }
        },
        {
          "id": "ear_r",
          "type": "polygon",
          "visible": "i == 0",
          "closed": false,
          "points": [[183, 2], [175, -16], [145, 2]],
          "stroke": { "color": "c_hair", "width": 2 }
        },
        {
          "id": "ear_l_in",
          "type": "polygon",
          "visible": "i == 0",
          "points": [[24, 1], [26, -8], [40, 1]],
          "fill": "c_pink",
          "opacity": 0.85
        },
        {
          "id": "ear_r_in",
          "type": "polygon",
          "visible": "i == 0",
          "points": [[173, 1], [171, -8], [157, 1]],
          "fill": "c_pink",
          "opacity": 0.85
        },
        {
          "id": "m_box",
          "type": "rect",
          "box": { "x": 0, "y": 0, "w": 197, "h": 150 },
          "fill": "c_panel",
          "stroke": { "color": "c_line", "width": 1 }
        },
        {
          "id": "m_mark",
          "type": "image",
          "src": "assets/icons/{m.icon}.svg",
          "optional": true,
          "fit": "contain",
          "box": { "x": 98, "y": 34, "w": 96, "h": 96 },
          "opacity": 0.09
        },
        {
          "id": "m_top",
          "type": "rect",
          "box": { "x": 0, "y": 0, "w": 197, "h": 3 },
          "fill": "match(m.trend, 'rising', c_trim, 'steady', c_eye, c_muted)"
        },
        {
          "id": "m_icon",
          "type": "image",
          "src": "assets/icons/{m.icon}.svg",
          "optional": true,
          "fit": "contain",
          "box": { "x": 68.5, "y": 18, "w": 60, "h": 60 }
        },
        {
          "id": "m_tile",
          "type": "rect",
          "visible": "not @m_icon.visible",
          "box": { "x": 68.5, "y": 18, "w": 60, "h": 60 },
          "fill": "c_line"
        },
        {
          "id": "m_letter",
          "type": "text",
          "font": "head",
          "text": "{upper(slice(m.name, 0, 1))}",
          "at": { "x": 98.5, "y": 48 },
          "size": 36,
          "color": "c_ice",
          "anchor": "center",
          "visible": "not @m_icon.visible"
        },
        {
          "id": "m_name",
          "type": "text",
          "font": "head",
          "text": "{m.name}",
          "at": { "x": 98.5, "y": 88 },
          "size": 22,
          "color": "c_ice",
          "anchor": "top",
          "max_width": 177
        },
        {
          "id": "m_meta",
          "type": "text",
          "font": "mono",
          "text": "{m.meta}",
          "at": { "x": 106.5, "y": 120 },
          "size": 11,
          "color": "c_muted",
          "anchor": "top"
        },
        {
          "id": "m_up",
          "type": "polygon",
          "visible": "m.trend == 'rising'",
          "points": [
            ["@m_meta.bounds.left - 15", 129],
            ["@m_meta.bounds.left - 11", 121],
            ["@m_meta.bounds.left - 7", 129]
          ],
          "fill": "c_trim"
        },
        {
          "id": "m_flat",
          "type": "rect",
          "visible": "m.trend != 'rising'",
          "box": { "x": "@m_meta.bounds.left - 15", "y": 124, "w": 8, "h": 3 },
          "fill": "match(m.trend, 'steady', c_eye, c_muted)"
        }
      ]
    },
    {
      "id": "sub_chip",
      "type": "group",
      "repeat": { "each": "sub", "item": "s", "index": "i" },
      "translate": { "x": "(i % 4) * 211", "y": "190 + floor(i / 4) * 42" },
      "layers": [
        {
          "id": "s_box",
          "type": "rect",
          "box": { "x": 0, "y": 0, "w": 197, "h": 34 },
          "fill": "c_panel",
          "stroke": { "color": "c_line", "width": 1 }
        },
        {
          "id": "s_icon",
          "type": "image",
          "src": "assets/icons/{s.icon}.svg",
          "optional": true,
          "fit": "contain",
          "box": { "x": 12, "y": 8, "w": 18, "h": 18 },
          "opacity": "s.active ? 1 : 0.5"
        },
        {
          "id": "s_tile",
          "type": "rect",
          "visible": "not @s_icon.visible",
          "box": { "x": 12, "y": 8, "w": 18, "h": 18 },
          "fill": "c_line",
          "opacity": "s.active ? 1 : 0.5"
        },
        {
          "id": "s_letter",
          "type": "text",
          "font": "head",
          "text": "{upper(slice(s.name, 0, 1))}",
          "at": { "x": 21, "y": 17 },
          "size": 11,
          "color": "c_ice",
          "anchor": "center",
          "visible": "not @s_icon.visible",
          "opacity": "s.active ? 1 : 0.5"
        },
        {
          "id": "s_name",
          "type": "text",
          "font": "head",
          "text": "{s.name}",
          "at": { "x": 40, "y": 8 },
          "size": 15,
          "color": "c_ice",
          "max_width": 148,
          "opacity": "s.active ? 1 : 0.5"
        }
      ]
    }
  ]
}
